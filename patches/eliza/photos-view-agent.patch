+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+import {
+  deviceOperationSupportedByCapabilities,
+  validateDeviceOperation,
+} from "./contract";
+import {
+  LIBRARY_LIMITS,
+  PHOTO_LIBRARY_CAPABILITY,
+} from "./photo-library-contract";
+import {
+  describePhotosViewOperation,
+  isPhotosViewOperation,
+  PHOTOS_FILTER_ALBUMS,
+  PHOTOS_SHARE_MAX,
+  PHOTOS_VIEW_CAPABILITY,
+  PHOTOS_VIEW_DIRECT_TYPES,
+  PHOTOS_VIEW_TYPES,
+  photosViewContextAllowed,
+  validatePhotosViewOperation,
+  validatePhotosViewResult,
+} from "./photos-view-contract";
+
+const id = (n: number, kind = "i") => `lib:${kind}:${n}:${n * 10}`;
+const ids = (count: number) =>
+  Array.from({ length: count }, (_, i) => id(i + 1));
+const valid = validatePhotosViewOperation;
+const invalid = (value: unknown) => () => validatePhotosViewOperation(value);
+
+describe("photos view contract", () => {
+  it("carries no product name", () => {
+    const source = readFileSync(
+      new URL("./photos-view-contract.ts", import.meta.url),
+      "utf8",
+    );
+    expect(source).not.toMatch(/Alpha/);
+  });
+
+  it("recognises exactly the Photos view operation types", () => {
+    expect([...PHOTOS_VIEW_TYPES]).toEqual([
+      "photos_filter",
+      "photos_open",
+      "photos_album_create",
+      "photos_share",
+    ]);
+    expect([...PHOTOS_VIEW_DIRECT_TYPES]).toEqual([
+      "photos_filter",
+      "photos_open",
+    ]);
+    expect([...PHOTOS_FILTER_ALBUMS]).toEqual([
+      "favorites",
+      "videos",
+      "camera",
+      "screenshots",
+    ]);
+    for (const type of PHOTOS_VIEW_TYPES)
+      expect(isPhotosViewOperation({ type })).toBe(true);
+    for (const type of ["photo_library_select", "photos_trash", "x"])
+      expect(isPhotosViewOperation({ type })).toBe(false);
+    expect(isPhotosViewOperation(null)).toBe(false);
+    expect(invalid({ type: "photos_trash", ids: [id(1)] })).toThrow(
+      "Unsupported Photos operation",
+    );
+    expect(invalid([])).toThrow("Invalid Photos operation");
+  });
+
+  it("validates photos_filter", () => {
+    expect(valid({ type: "photos_filter" })).toEqual({ type: "photos_filter" });
+    const full = {
+      type: "photos_filter",
+      from: 0,
+      to: 1_700_000_000_000,
+      kind: "video",
+      favorite: false,
+      album: "custom:trip_2026-a",
+      text: "beach",
+    };
+    expect(valid(full)).toEqual(full);
+    for (const album of PHOTOS_FILTER_ALBUMS)
+      expect(valid({ type: "photos_filter", album })).toEqual({
+        type: "photos_filter",
+        album,
+      });
+    expect(
+      valid({ type: "photos_filter", text: "x".repeat(LIBRARY_LIMITS.query) }),
+    ).toEqual({
+      type: "photos_filter",
+      text: "x".repeat(LIBRARY_LIMITS.query),
+    });
+    for (const from of [-1, 1.5, "1", Number.MAX_SAFE_INTEGER + 1, Number.NaN])
+      expect(invalid({ type: "photos_filter", from })).toThrow(
+        "Invalid filter date",
+      );
+    expect(invalid({ type: "photos_filter", from: 2, to: 1 })).toThrow(
+      "Invalid filter date range",
+    );
+    expect(invalid({ type: "photos_filter", kind: "all" })).toThrow(
+      "Invalid filter kind",
+    );
+    expect(invalid({ type: "photos_filter", favorite: "yes" })).toThrow(
+      "Invalid favorites filter",
+    );
+    for (const album of [
+      "Favorites",
+      "custom:",
+      "custom:a b",
+      `custom:${"a".repeat(81)}`,
+      3,
+    ])
+      expect(invalid({ type: "photos_filter", album })).toThrow(
+        "Invalid filter album",
+      );
+    for (const text of [
+      "x".repeat(LIBRARY_LIMITS.query + 1),
+      "a\nb",
+      "a\u007f",
+      7,
+    ])
+      expect(invalid({ type: "photos_filter", text })).toThrow(
+        "Invalid filter text",
+      );
+    expect(invalid({ type: "photos_filter", favorites: true })).toThrow(
+      "Unexpected Photos field",
+    );
+  });
+
+  it("validates photos_open", () => {
+    expect(valid({ type: "photos_open", id: id(4, "v") })).toEqual({
+      type: "photos_open",
+      id: id(4, "v"),
+    });
+    for (const bad of ["4", "lib:x:1:1", "m:external:i:1", undefined])
+      expect(invalid({ type: "photos_open", id: bad })).toThrow(
+        "Invalid library id",
+      );
+    expect(invalid({ type: "photos_open", id: id(1), ids: [] })).toThrow(
+      "Unexpected Photos field",
+    );
+  });
+
+  it("validates photos_album_create without truncating", () => {
+    expect(
+      valid({ type: "photos_album_create", name: "  Trip  ", ids: [id(1)] }),
+    ).toEqual({ type: "photos_album_create", name: "Trip", ids: [id(1)] });
+    expect(
+      valid({ type: "photos_album_create", name: "a".repeat(80), ids: ids(2) })
+        .name,
+    ).toBe("a".repeat(80));
+    expect(
+      valid({
+        type: "photos_album_create",
+        name: "All",
+        ids: ids(LIBRARY_LIMITS.kept),
+      }).ids,
+    ).toHaveLength(LIBRARY_LIMITS.kept);
+    for (const name of ["", "   ", "a".repeat(81), "a\tb", 1, undefined])
+      expect(
+        invalid({ type: "photos_album_create", name, ids: [id(1)] }),
+      ).toThrow("Choose an album name between 1 and 80 characters");
+    for (const bad of [
+      [],
+      [id(1), id(1)],
+      ["x"],
+      ids(LIBRARY_LIMITS.kept + 1),
+      "x",
+    ])
+      expect(
+        invalid({ type: "photos_album_create", name: "Trip", ids: bad }),
+      ).toThrow("Invalid album items");
+    expect(
+      invalid({
+        type: "photos_album_create",
+        name: "Trip",
+        ids: [id(1)],
+        id: "a",
+      }),
+    ).toThrow("Unexpected Photos field");
+  });
+
+  it("validates photos_share", () => {
+    expect(valid({ type: "photos_share", ids: [id(1), id(2, "v")] })).toEqual({
+      type: "photos_share",
+      ids: [id(1), id(2, "v")],
+    });
+    expect(
+      valid({ type: "photos_share", ids: ids(PHOTOS_SHARE_MAX) }).ids,
+    ).toHaveLength(100);
+    for (const bad of [[], [id(1), id(1)], ["x"], ids(PHOTOS_SHARE_MAX + 1)])
+      expect(invalid({ type: "photos_share", ids: bad })).toThrow(
+        "Invalid share items",
+      );
+    expect(
+      invalid({ type: "photos_share", ids: [id(1)], target: "mail" }),
+    ).toThrow("Unexpected Photos field");
+  });
+
+  it("is admitted by the device contract and wraps its errors", () => {
+    expect(validateDeviceOperation({ type: "photos_open", id: id(1) })).toEqual(
+      { type: "photos_open", id: id(1) },
+    );
+    expect(() =>
+      validateDeviceOperation({ type: "photos_share", ids: [] }),
+    ).toThrow("Invalid Photos operation: Invalid share items");
+  });
+
+  it("is offered only when both photos.library.v1 and photos.view.v1 were negotiated", () => {
+    expect(PHOTOS_VIEW_CAPABILITY).toBe("photos.view.v1");
+    const both = [PHOTO_LIBRARY_CAPABILITY, PHOTOS_VIEW_CAPABILITY];
+    for (const type of PHOTOS_VIEW_TYPES) {
+      expect(deviceOperationSupportedByCapabilities(type, both)).toBe(true);
+      expect(
+        deviceOperationSupportedByCapabilities(type, [
+          PHOTO_LIBRARY_CAPABILITY,
+        ]),
+      ).toBe(false);
+      expect(
+        deviceOperationSupportedByCapabilities(type, [PHOTOS_VIEW_CAPABILITY]),
+      ).toBe(false);
+      expect(deviceOperationSupportedByCapabilities(type, [])).toBe(false);
+      expect(deviceOperationSupportedByCapabilities(type, undefined)).toBe(
+        false,
+      );
+    }
+    // The capability does not widen unrelated operations.
+    expect(deviceOperationSupportedByCapabilities("notes_query", both)).toBe(
+      false,
+    );
+  });
+
+  it("describes each operation for the review card in short owner-facing text", () => {
+    const d = describePhotosViewOperation;
+    expect(d({ type: "photos_filter" })).toEqual({
+      title: "Filter Photos",
+      description: "Everything",
+    });
+    expect(
+      d({
+        type: "photos_filter",
+        kind: "video",
+        favorite: true,
+        album: "camera",
+        text: "beach",
+        from: 1,
+      }),
+    ).toEqual({
+      title: "Filter Photos",
+      description:
+        "Videos · Favorites · In Camera · “beach” · In the requested dates",
+    });
+    expect(d({ type: "photos_filter", album: "custom:a1" }).description).toBe(
+      "In an album",
+    );
+    expect(d({ type: "photos_open", id: id(1) })).toEqual({
+      title: "Open photo",
+      description: "In Photos. Nothing is changed or shared.",
+    });
+    expect(d({ type: "photos_open", id: id(1, "v") }).title).toBe("Open video");
+    expect(
+      d({ type: "photos_album_create", name: "Trip", ids: [id(1), id(2)] }),
+    ).toEqual({
+      title: "Create album “Trip”",
+      description: "2 items. You confirm it in Photos.",
+    });
+    expect(d({ type: "photos_share", ids: [id(1)] }, "Eliza")).toEqual({
+      title: "Share 1 item",
+      description:
+        "You confirm it in Photos, then pick where it goes in Android's share sheet. Nothing leaves Eliza before that.",
+    });
+  });
+
+  it("validates results without accepting extra fields", () => {
+    const filter = { type: "photos_filter" } as const;
+    expect(
+      validatePhotosViewResult(filter, {
+        kind: "photos_filter",
+        shown: 0,
+        more: false,
+      }),
+    ).toEqual({ kind: "photos_filter", shown: 0, more: false });
+    for (const bad of [
+      { kind: "photos_filter", shown: -1, more: false },
+      { kind: "photos_filter", shown: 1.5, more: false },
+      { kind: "photos_filter", shown: 1 },
+      { kind: "photos_filter", shown: 1, more: true, items: [] },
+      { kind: "photos_open", opened: true },
+      null,
+    ])
+      expect(() => validatePhotosViewResult(filter, bad)).toThrow();
+    const open = { type: "photos_open", id: id(1) } as const;
+    expect(
+      validatePhotosViewResult(open, { kind: "photos_open", opened: false }),
+    ).toEqual({ kind: "photos_open", opened: false });
+    expect(() =>
+      validatePhotosViewResult(open, { kind: "photos_open", opened: 1 }),
+    ).toThrow("Invalid photos open result");
+    for (const op of [
+      { type: "photos_album_create", name: "Trip", ids: [id(1), id(2)] },
+      { type: "photos_share", ids: [id(1), id(2)] },
+    ] as const) {
+      const row = {
+        kind: op.type,
+        status: "review_opened",
+        count: 1,
+        missing: 1,
+      };
+      expect(validatePhotosViewResult(op, row)).toEqual(row);
+      for (const bad of [
+        { ...row, count: 0, missing: 2 },
+        { ...row, count: 2, missing: 1 },
+        { ...row, status: "done" },
+        { ...row, ids: [] },
+      ])
+        expect(() => validatePhotosViewResult(op, bad)).toThrow();
+    }
+  });
+
+  it("allows review only in Photos on the unlocked phone", () => {
+    expect(photosViewContextAllowed({ view: "photos" })).toBe(true);
+    expect(photosViewContextAllowed({ view: "photos", sensitive: true })).toBe(
+      false,
+    );
+    expect(photosViewContextAllowed({ view: "home" })).toBe(false);
+  });
+});
diff --git a/plugins/plugin-assistant/src/services/device-actions/photos-view-contract.ts b/plugins/plugin-assistant/src/services/device-actions/photos-view-contract.ts
new file mode 100644
index 0000000..2c6c2c3
--- /dev/null
+++ b/plugins/plugin-assistant/src/services/device-actions/photos-view-contract.ts
@@ -0,0 +1,312 @@
+/** Phone Photos view operations: filter the grid, open one item, create an album, share items.
+ * Dependency-free apart from the photo library contract, so hosts and tests can use the rules
+ * anywhere. Validation rejects rather than truncates. Owner-facing text names the app through an
+ * `appName` argument; hosts pass their product name.
+ *
+ * `photos_filter` only narrows what the Photos grid shows, behind a clearable chip, and returns
+ * counts, never items. `photos_open` opens one item in the Photos viewer. Neither changes or
+ * shares media, so both may run directly when the owner's own current message asked for them;
+ * otherwise they are reviewed. `photos_album_create` is a data change and `photos_share` sends
+ * media out of the phone, so the owner reviews each in Photos first; a share then opens
+ * Android's share sheet, and nothing leaves the phone before the owner picks a target there.
+ * All four require both `photos.library.v1` and `photos.view.v1`. */
+import {
+  isLibraryId,
+  LIBRARY_APP_NAME,
+  LIBRARY_LIMITS,
+  type LibraryKind,
+  libraryKindOf,
+  PHOTO_LIBRARY_CAPABILITY,
+} from "./photo-library-contract.ts";
+
+export const PHOTOS_VIEW_CAPABILITY = "photos.view.v1";
+/** Album keys photos_filter accepts besides a custom album id ("custom:<id>"). */
+export const PHOTOS_FILTER_ALBUMS = [
+  "favorites",
+  "videos",
+  "camera",
+  "screenshots",
+] as const;
+export type PhotosFilterAlbum =
+  | (typeof PHOTOS_FILTER_ALBUMS)[number]
+  | `custom:${string}`;
+export const PHOTOS_ALBUM_NAME_MAX = 80;
+export const PHOTOS_SHARE_MAX = 100;
+const CUSTOM_ALBUM = /^custom:[A-Za-z0-9_-]{1,80}$/;
+const CONTROL = /[\u0000-\u001f\u007f]/;
+
+export type PhotosViewOperation =
+  | {
+      type: "photos_filter";
+      from?: number;
+      to?: number;
+      kind?: LibraryKind;
+      favorite?: boolean;
+      album?: PhotosFilterAlbum;
+      text?: string;
+    }
+  | { type: "photos_open"; id: string }
+  | { type: "photos_album_create"; name: string; ids: string[] }
+  | { type: "photos_share"; ids: string[] };
+export type PhotosViewType = PhotosViewOperation["type"];
+
+export const PHOTOS_VIEW_TYPES: readonly PhotosViewType[] = [
+  "photos_filter",
+  "photos_open",
+  "photos_album_create",
+  "photos_share",
+];
+/** May run without a review only when bound to the owner's own current message. */
+export const PHOTOS_VIEW_DIRECT_TYPES: readonly PhotosViewType[] = [
+  "photos_filter",
+  "photos_open",
+];
+
+export function isPhotosViewType(type: unknown): type is PhotosViewType {
+  return (PHOTOS_VIEW_TYPES as readonly unknown[]).includes(type);
+}
+export function isPhotosViewOperation(
+  value: unknown,
+): value is PhotosViewOperation {
+  return (
+    !!value &&
+    typeof value === "object" &&
+    isPhotosViewType((value as { type?: unknown }).type)
+  );
+}
+/** Both the library and the view capability must have been negotiated. */
+export function photosViewCapabilityAvailable(
+  capabilities?: readonly string[],
+): boolean {
+  return (
+    capabilities?.includes(PHOTO_LIBRARY_CAPABILITY) === true &&
+    capabilities.includes(PHOTOS_VIEW_CAPABILITY)
+  );
+}
+
+type Bag = Record<string, unknown>;
+function bag(value: unknown, message: string): Bag {
+  if (!value || typeof value !== "object" || Array.isArray(value))
+    throw Error(message);
+  return value as Bag;
+}
+function only(op: Bag, keys: readonly string[], message: string): void {
+  for (const key of Object.keys(op))
+    if (!keys.includes(key)) throw Error(message);
+}
+function libraryIds(value: unknown, max: number, message: string): string[] {
+  if (
+    !Array.isArray(value) ||
+    !value.length ||
+    value.length > max ||
+    !value.every(isLibraryId) ||
+    new Set(value).size !== value.length
+  )
+    throw Error(message);
+  return [...value] as string[];
+}
+
+export function validatePhotosViewOperation(
+  value: unknown,
+): PhotosViewOperation {
+  const op = bag(value, "Invalid Photos operation");
+  const allowed = (keys: string[]) => only(op, keys, "Unexpected Photos field");
+  if (op.type === "photos_filter") {
+    allowed(["type", "from", "to", "kind", "favorite", "album", "text"]);
+    for (const key of ["from", "to"] as const)
+      if (
+        op[key] !== undefined &&
+        !(Number.isSafeInteger(op[key]) && (op[key] as number) >= 0)
+      )
+        throw Error("Invalid filter date");
+    if (
+      op.from !== undefined &&
+      op.to !== undefined &&
+      (op.from as number) > (op.to as number)
+    )
+      throw Error("Invalid filter date range");
+    if (op.kind !== undefined && op.kind !== "image" && op.kind !== "video")
+      throw Error("Invalid filter kind");
+    if (op.favorite !== undefined && typeof op.favorite !== "boolean")
+      throw Error("Invalid favorites filter");
+    if (
+      op.album !== undefined &&
+      !(
+        typeof op.album === "string" &&
+        ((PHOTOS_FILTER_ALBUMS as readonly string[]).includes(op.album) ||
+          CUSTOM_ALBUM.test(op.album))
+      )
+    )
+      throw Error("Invalid filter album");
+    if (
+      op.text !== undefined &&
+      !(
+        typeof op.text === "string" &&
+        op.text.length <= LIBRARY_LIMITS.query &&
+        !CONTROL.test(op.text)
+      )
+    )
+      throw Error("Invalid filter text");
+    return {
+      type: "photos_filter",
+      ...(op.from !== undefined ? { from: op.from as number } : {}),
+      ...(op.to !== undefined ? { to: op.to as number } : {}),
+      ...(op.kind !== undefined ? { kind: op.kind as LibraryKind } : {}),
+      ...(op.favorite !== undefined
+        ? { favorite: op.favorite as boolean }
+        : {}),
+      ...(op.album !== undefined
+        ? { album: op.album as PhotosFilterAlbum }
+        : {}),
+      ...(op.text !== undefined ? { text: op.text as string } : {}),
+    };
+  }
+  if (op.type === "photos_open") {
+    allowed(["type", "id"]);
+    if (!isLibraryId(op.id)) throw Error("Invalid library id");
+    return { type: "photos_open", id: op.id };
+  }
+  if (op.type === "photos_album_create") {
+    allowed(["type", "name", "ids"]);
+    if (
+      typeof op.name !== "string" ||
+      op.name.trim().length < 1 ||
+      op.name.trim().length > PHOTOS_ALBUM_NAME_MAX ||
+      CONTROL.test(op.name)
+    )
+      throw Error("Choose an album name between 1 and 80 characters");
+    return {
+      type: "photos_album_create",
+      name: op.name.trim(),
+      ids: libraryIds(op.ids, LIBRARY_LIMITS.kept, "Invalid album items"),
+    };
+  }
+  if (op.type === "photos_share") {
+    allowed(["type", "ids"]);
+    return {
+      type: "photos_share",
+      ids: libraryIds(op.ids, PHOTOS_SHARE_MAX, "Invalid share items"),
+    };
+  }
+  throw Error("Unsupported Photos operation");
+}
+
+const quoted = (value: string) => `“${value}”`;
+const items = (count: number) => `${count} ${count === 1 ? "item" : "items"}`;
+const ALBUM_LABELS: Record<(typeof PHOTOS_FILTER_ALBUMS)[number], string> = {
+  favorites: "Favorites",
+  videos: "Videos",
+  camera: "Camera",
+  screenshots: "Screenshots",
+};
+/** The review card: the change itself, nothing else. */
+export function describePhotosViewOperation(
+  op: PhotosViewOperation,
+  appName: string = LIBRARY_APP_NAME,
+): { title: string; description: string } {
+  if (op.type === "photos_filter")
+    return {
+      title: "Filter Photos",
+      description:
+        [
+          op.kind === "image" ? "Photos" : op.kind === "video" ? "Videos" : "",
+          op.favorite === true
+            ? "Favorites"
+            : op.favorite === false
+              ? "Not favorites"
+              : "",
+          op.album
+            ? op.album.startsWith("custom:")
+              ? "In an album"
+              : `In ${ALBUM_LABELS[op.album as keyof typeof ALBUM_LABELS]}`
+            : "",
+          op.text ? quoted(op.text) : "",
+          op.from !== undefined || op.to !== undefined
+            ? "In the requested dates"
+            : "",
+        ]
+          .filter(Boolean)
+          .join(" · ") || "Everything",
+    };
+  if (op.type === "photos_open")
+    return {
+      title: libraryKindOf(op.id) === "video" ? "Open video" : "Open photo",
+      description: "In Photos. Nothing is changed or shared.",
+    };
+  if (op.type === "photos_album_create")
+    return {
+      title: `Create album ${quoted(op.name)}`,
+      description: `${items(op.ids.length)}. You confirm it in Photos.`,
+    };
+  return {
+    title: `Share ${items(op.ids.length)}`,
+    description: `You confirm it in Photos, then pick where it goes in Android's share sheet. Nothing leaves ${appName} before that.`,
+  };
+}
+
+/** Where a proposal may be reviewed or run: Photos, open on the unlocked phone. */
+export function photosViewContextAllowed(context: {
+  view: string;
+  sensitive?: boolean;
+}): boolean {
+  return !context.sensitive && context.view === "photos";
+}
+
+/** The structured result the phone returns. Filter and open report only counts or a flag; an
+ * album or share result proves only that the owner review opened in Photos. */
+export type PhotosViewResult =
+  | { kind: "photos_filter"; shown: number; more: boolean }
+  | { kind: "photos_open"; opened: boolean }
+  | {
+      kind: "photos_album_create";
+      status: "review_opened";
+      count: number;
+      missing: number;
+    }
+  | {
+      kind: "photos_share";
+      status: "review_opened";
+      count: number;
+      missing: number;
+    };
+const count = (value: unknown, min: number) =>
+  Number.isInteger(value) && (value as number) >= min;
+export function validatePhotosViewResult(
+  op: PhotosViewOperation,
+  value: unknown,
+): PhotosViewResult {
+  const row = bag(value, "Invalid Photos result");
+  if (row.kind !== op.type) throw Error("Photos result kind mismatch");
+  const keys = (list: string[]) =>
+    only(row, list, "Unexpected Photos result field");
+  if (op.type === "photos_filter") {
+    keys(["kind", "shown", "more"]);
+    if (!count(row.shown, 0) || typeof row.more !== "boolean")
+      throw Error("Invalid photos filter result");
+    return { kind: op.type, shown: row.shown as number, more: row.more };
+  }
+  if (op.type === "photos_open") {
+    keys(["kind", "opened"]);
+    if (typeof row.opened !== "boolean")
+      throw Error("Invalid photos open result");
+    return { kind: op.type, opened: row.opened };
+  }
+  keys(["kind", "status", "count", "missing"]);
+  if (
+    row.status !== "review_opened" ||
+    !count(row.count, 1) ||
+    !count(row.missing, 0) ||
+    (row.count as number) + (row.missing as number) !== op.ids.length
+  )
+    throw Error(
+      op.type === "photos_share"
+        ? "Invalid share review result"
+        : "Invalid album review result",
+    );
+  return {
+    kind: op.type,
+    status: "review_opened",
+    count: row.count as number,
+    missing: row.missing as number,
+  };
+}
