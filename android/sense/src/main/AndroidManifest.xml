<?xml version="1.0" encoding="utf-8"?>
<!--
 Alpha Phone always-on listener (ADR docs/adr/0001-privileged-listener.md). Ships only in the
 Alpha AOSP image as a privileged, persistent system_ext app. It deliberately declares NO
 android.permission.INTERNET and NO network-state permission: the process gets no inet group, so
 audio and transcripts cannot leave the phone from here. tools:node="remove" strips any network
 permission a library might merge in; scripts/aosp-listener.mjs re-checks the built APK.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
 <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
 <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
 <uses-permission android:name="android.permission.RECORD_AUDIO" />
 <!-- signature|privileged: granted only through the image's privapp allowlist. The capture then yields to every other microphone client. -->
 <uses-permission android:name="android.permission.CAPTURE_AUDIO_HOTWORD" />
 <!-- signature|privileged: lets the persistent listener open Alpha's assistant surface from the background. -->
 <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
 <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

 <!-- Held by Alpha (same signer) to read status and pause or turn off. It cannot turn listening on. -->
 <permission android:name="ai.elizaresearch.alphaphone.sense.permission.LISTENER_CONTROL"
     android:protectionLevel="signature"
     android:label="Control always-on listening" />

 <queries><package android:name="ai.elizaresearch.alphaphone" /></queries>

 <application
     android:name=".SenseApplication"
     android:label="Alpha listening"
     android:icon="@drawable/ic_listening"
     android:persistent="true"
     android:directBootAware="true"
     android:allowBackup="false"
     android:fullBackupContent="false"
     android:hasFragileUserData="true"
     android:usesCleartextTraffic="false"
     tools:ignore="DataExtractionRules">
  <service android:name=".ListeningService" android:exported="false"
      android:foregroundServiceType="microphone" android:directBootAware="true" />
  <service android:name=".ListenerTileService" android:exported="true"
      android:label="Listening" android:icon="@drawable/ic_listening"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
   <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
   <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
  </service>
  <receiver android:name=".ListenerActionReceiver" android:exported="false" android:directBootAware="true" />
  <provider android:name=".ListenerControlProvider" android:exported="true" android:directBootAware="true"
      android:authorities="ai.elizaresearch.alphaphone.sense.control"
      android:permission="ai.elizaresearch.alphaphone.sense.permission.LISTENER_CONTROL" />
  <!-- Consent and settings. Exported so Alpha's Settings and the tile's long-press can open it; it only
       explains and records an explicit tap, and ignores touches while obscured. -->
  <activity android:name=".ConsentActivity" android:exported="true" android:excludeFromRecents="true"
      android:label="Always-on listening"
      android:theme="@android:style/Theme.DeviceDefault.DayNight">
   <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" /></intent-filter>
  </activity>
 </application>
</manifest>
