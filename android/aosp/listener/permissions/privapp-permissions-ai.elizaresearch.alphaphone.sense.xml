<?xml version="1.0" encoding="utf-8"?>
<!--
 Privileged permissions for the Alpha always-on listener, and nothing else.
 The ordinary Alpha app (ai.elizaresearch.alphaphone) gets no privileged permission.

 Deliberately absent (do not add without a new owner-approved ADR):
   CAPTURE_AUDIO_OUTPUT, CAPTURE_MEDIA_OUTPUT, CAPTURE_VOICE_COMMUNICATION_OUTPUT  (would record calls/output)
   BYPASS_CONCURRENT_RECORD_AUDIO_RESTRICTION                                       (would take the mic from calls/apps)
   EXEMPT_FROM_AUDIO_RECORD_RESTRICTIONS, RECORD_BACKGROUND_AUDIO                   (background-capture exemptions)
   MODIFY_AUDIO_ROUTING, READ_PHONE_STATE, INTERNET                                 (not needed; no network at all)
 RECORD_AUDIO is not pre-granted: the listener asks for it only after the user opts in.
-->
<permissions>
    <privapp-permissions package="ai.elizaresearch.alphaphone.sense">
        <!-- HOTWORD capture source: yields to every other microphone client. -->
        <permission name="android.permission.CAPTURE_AUDIO_HOTWORD" />
        <!-- Opens Alpha's assistant surface after the wake phrase. -->
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    </privapp-permissions>
</permissions>
