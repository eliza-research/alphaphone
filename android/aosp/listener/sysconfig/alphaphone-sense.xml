<?xml version="1.0" encoding="utf-8"?>
<!--
 Alpha always-on listener system configuration.
 - Installed for the system (primary) user only: no secondary, guest or work-profile listener.
 - Only Alpha (status/pause through the signature-protected provider, and opening the consent
   screen as HOME), SystemUI (Quick Settings tile, notification actions), PermissionController
   (the RECORD_AUDIO/POST_NOTIFICATIONS request on the consent screen) and Settings (app and
   notification settings) may associate with the listener. Whether the consent flow needs more is
   checked on the booted image (gate G2).
 No power-save or background-restriction exemption is granted.
-->
<config>
    <install-in-user-type package="ai.elizaresearch.alphaphone.sense">
        <install-in user-type="android.os.usertype.full.SYSTEM" />
    </install-in-user-type>
    <allow-association target="ai.elizaresearch.alphaphone.sense" allowed="ai.elizaresearch.alphaphone" />
    <allow-association target="ai.elizaresearch.alphaphone.sense" allowed="com.android.systemui" />
    <allow-association target="ai.elizaresearch.alphaphone.sense" allowed="com.android.permissioncontroller" />
    <allow-association target="ai.elizaresearch.alphaphone.sense" allowed="com.android.settings" />
</config>
