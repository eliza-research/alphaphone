// Alpha Phone always-on listener for the Alpha AOSP image (docs/adr/0001-privileged-listener.md).
// Staged by `npm run aosp:stage -- ... --listener-apk FILE`, which copies this directory and the
// admitted listener APK (as AlphaSense.apk) next to the launcher module. Not built by Gradle.

android_app_import {
    name: "AlphaSense",
    apk: "AlphaSense.apk",
    // Signed by the same release key as the Alpha launcher APK (checked at staging):
    // the listener's LISTENER_CONTROL permission is signature-level.
    presigned: true,
    privileged: true,
    system_ext_specific: true,
    dex_preopt: {
        enabled: false,
    },
    required: [
        "privapp-permissions-ai.elizaresearch.alphaphone.sense.xml",
        "alphaphone-sense-sysconfig.xml",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-ai.elizaresearch.alphaphone.sense.xml",
    src: "permissions/privapp-permissions-ai.elizaresearch.alphaphone.sense.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "alphaphone-sense-sysconfig.xml",
    src: "sysconfig/alphaphone-sense.xml",
    sub_dir: "sysconfig",
    system_ext_specific: true,
}
