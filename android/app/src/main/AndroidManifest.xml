<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
 <uses-permission android:name="android.permission.RECORD_AUDIO" />
 <uses-permission android:name="android.permission.INTERNET" />
 <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
 <uses-permission android:name="android.permission.READ_CALENDAR" />
 <uses-permission android:name="android.permission.WRITE_CALENDAR" />
 <!-- Photos asks explicitly; selected-only access stays selected-only in its catalog. -->
 <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
 <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
 <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
 <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
 <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
 <!-- Delegation to the installed Clock app; Alpha does not schedule exact alarms itself. -->
 <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
 <!-- Camera access is requested only on entry to the native camera view. -->
 <uses-permission android:name="android.permission.CAMERA" />
 <uses-feature android:name="android.hardware.camera" android:required="false" />
 <uses-feature android:name="android.hardware.camera.any" android:required="false" />
 <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
 <!-- Contacts are read-only and exist only on the Alpha AOSP image (P-36): the launcher manifest declares
      READ_CONTACTS, the standalone manifest removes it, and AlphaTelephonyPlugin requests it only on the
      verified image. No build writes contacts. -->
 <uses-permission android:name="android.permission.WRITE_CONTACTS" tools:node="remove" />
 <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:node="remove" />
 <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove" />
 <!-- minSdk 29 uses scoped storage; the camera plugin requests this only below API 29. -->
 <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
 <queries>
  <intent><action android:name="android.intent.action.INSERT"/><data android:mimeType="vnd.android.cursor.dir/contact"/></intent>
  <intent><action android:name="android.intent.action.EDIT"/><data android:mimeType="vnd.android.cursor.item/contact"/></intent>
  <!-- Narrow visibility for password-provider setup; no vault or form access. -->
  <package android:name="proton.android.pass"/>
  <!-- The AOSP image's always-on listener (android/sense). Absent on ordinary phones; Alpha then reports it unavailable. -->
  <package android:name="ai.elizaresearch.alphaphone.sense"/>
  <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="content" android:mimeType="application/pdf"/></intent><intent><action android:name="android.intent.action.VIEW"/><data android:scheme="content" android:mimeType="image/*"/></intent><intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
  <intent><action android:name="android.media.action.STILL_IMAGE_CAMERA"/></intent>
  <intent><action android:name="android.intent.action.OPEN_DOCUMENT"/><data android:mimeType="*/*"/></intent>
  <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="geo"/></intent>
  <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="https"/></intent>
  <!-- Custom Tabs providers for the in-app Eliza Cloud Google sign-in (androidx.browser). -->
  <intent><action android:name="android.support.customtabs.action.CustomTabsService"/></intent>
  <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="http"/></intent>
  <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.APP_CALENDAR"/></intent>
  <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.APP_EMAIL"/></intent>
  <intent><action android:name="android.intent.action.INSERT"/><data android:scheme="content" android:host="com.android.calendar" android:mimeType="vnd.android.cursor.dir/event"/></intent>
  <intent><action android:name="android.intent.action.SENDTO"/><data android:scheme="mailto"/></intent>
  <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH"/></intent>
  <intent><action android:name="android.settings.SETTINGS"/></intent>
  <intent><action android:name="android.settings.APP_NOTIFICATION_SETTINGS"/></intent>
  <!-- Home Phone shortcut: resolve and open the user's dialer with an empty dial pad. Alpha's own
       Phone view, calls and call permissions stay MVP-DEFERRED. -->
  <intent><action android:name="android.intent.action.DIAL"/><data android:scheme="tel"/></intent>
  <!-- SMS handoff visibility (SENDTO smsto) is declared only by the launcher manifest, for the Alpha AOSP image. -->
  <intent><action android:name="android.intent.action.SET_ALARM"/></intent>
  <intent><action android:name="android.intent.action.SHOW_ALARMS"/></intent>
  <intent><action android:name="android.intent.action.SNOOZE_ALARM"/></intent>
  <intent><action android:name="android.intent.action.DISMISS_ALARM"/></intent>
 </queries>
 <!-- Signature permission defined by the image's listener: read its status and pause or turn it off. Grants nothing elsewhere. -->
 <uses-permission android:name="ai.elizaresearch.alphaphone.sense.permission.LISTENER_CONTROL" />
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
 <!-- Turn-by-turn guidance keeps running with the screen off only while the user navigates. -->
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
 <!-- Already merged from the location plugin; declared here so the location service type is checked against them. -->
 <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
 <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
 <application android:name=".AlphaApplication" android:label="@string/app_name" android:icon="@drawable/app_icon" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true" android:usesCleartextTraffic="false" android:networkSecurityConfig="@xml/network_security_config" android:theme="@style/AppTheme">
  <service android:name=".ElizaAgentService" android:exported="false" android:foregroundServiceType="specialUse">
   <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-started local personal agent runtime" />
  </service>
  <service android:name=".AlphaNavigationService" android:exported="false" android:foregroundServiceType="location" />
  <!-- Android alone binds this action tile. A locked-device tap requires unlocking; no capture
       or connection authority comes from a tile being present in Quick Settings. -->
  <service android:name=".AlphaQuickSettingsTile" android:label="@string/alpha_quick_settings_label" android:icon="@drawable/notification_icon" android:exported="true" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
   <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
   <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="false"/>
  </service>
  <activity android:name=".AlphaMailPdfActivity" android:exported="false" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="PDF attachment" />
  <service android:name=".IsolatedPdfService" android:exported="false" android:isolatedProcess="true" android:process=":isolated_pdf" android:stopWithTask="true" />
  <!-- Release-build data integrity export for pilot updates: per-file HMAC digests only, read-only,
       in its own process, readable only with the platform DUMP permission (adb shell). -->
  <provider android:name=".release.DataIntegrityProvider" android:authorities="${applicationId}.integrity" android:exported="true" android:permission="android.permission.DUMP" android:process=":integrity" android:grantUriPermissions="false" />
  <provider android:name=".AlphaMailFileProvider" android:authorities="${applicationId}.mailattachments" android:exported="false" android:grantUriPermissions="true"><meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/mail_attachment_paths"/></provider>
  <service android:name=".AlphaNotificationListener" android:label="Alpha Phone selected notifications" android:exported="true" android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
   <intent-filter><action android:name="android.service.notification.NotificationListenerService"/></intent-filter>
  </service>
  <!-- Alpha's password vault as an Android Autofill provider. The user selects it in Android's own
       confirmation; Alpha never sets secure settings. The vault lives in the no-backup directory. -->
  <service android:name="ai.eliza.plugins.passwords.ElizaPasswordAutofillService" android:label="@string/eliza_passwords_service_label" android:exported="true" android:permission="android.permission.BIND_AUTOFILL_SERVICE">
   <intent-filter><action android:name="android.service.autofill.AutofillService"/></intent-filter>
   <meta-data android:name="android.autofill" android:resource="@xml/eliza_passwords_autofill_service"/>
  </service>
  <receiver android:name=".ReminderReceiver" android:exported="false">
   <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED"/><action android:name="android.intent.action.MY_PACKAGE_REPLACED"/><action android:name="android.intent.action.TIME_SET"/><action android:name="android.intent.action.TIMEZONE_CHANGED"/></intent-filter>
  </receiver>
  <!-- Digests and agent schedules run in the resident runtime: bring back the owner-enabled agent (#394). Nothing is replayed. -->
  <receiver android:name=".ResidentScheduleReceiver" android:exported="false">
   <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED"/><action android:name="android.intent.action.MY_PACKAGE_REPLACED"/><action android:name="android.intent.action.TIME_SET"/><action android:name="android.intent.action.TIMEZONE_CHANGED"/></intent-filter>
  </receiver>
  <!-- Explicit user-selected assistant. Separate task preserves the invoking app's back stack. -->
  <activity android:name=".AlphaAssistActivity" android:enabled="false" android:exported="false" android:launchMode="singleTask" android:taskAffinity="${applicationId}.assistant" android:excludeFromRecents="true" android:screenOrientation="${appOrientation}" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|navigation" android:theme="@style/AppTheme.Launch">
   <intent-filter><action android:name="android.intent.action.ASSIST"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
  </activity>
  <!-- Explicit native Power entry; only existing platform STATUS_BAR_SERVICE holders may launch.
       Cold entry is surface-only; no intent filter or extra can authorize microphone capture. -->
  <activity android:name=".AlphaPowerVoiceActivity" android:enabled="false" android:exported="false" android:permission="android.permission.STATUS_BAR_SERVICE" android:launchMode="singleTask" android:taskAffinity="${applicationId}.assistant" android:excludeFromRecents="true" android:screenOrientation="${appOrientation}" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|navigation" android:theme="@style/AppTheme.Launch" />
  <!-- Unfinished Reset Alpha data (#409). Own process: none of Alpha's providers or startup initializers run there. -->
  <activity android:name=".ResetRecoveryActivity" android:exported="false" android:process=":reset_recovery" android:taskAffinity="${applicationId}.reset" android:excludeFromRecents="true" android:launchMode="singleTask" android:theme="@android:style/Theme.DeviceDefault.DayNight" android:label="Reset Alpha data" />
  <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" android:screenOrientation="${appOrientation}" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|navigation" android:theme="@style/AppTheme.Launch">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
   <intent-filter><action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/><data android:scheme="alphaphone" android:host="cloud-delegation"/></intent-filter>
   <!-- Verified App Links are build-gated: with the Gradle property ELIZAOS_APP_LINK_HOST set,
        android/app/product.gradle overlays https autoVerify filters for ${appLinkHost} with pathPrefix
        /alphaphone/cloud-delegation and path /alphaphone/auth/callback (the in-app Eliza Cloud sign-in
        return, AlphaCloudSignInPlugin). Unset (the default), no such filter exists. Set it only after
        scripts/render-assetlinks.mjs output (release signer, never a debug or placeholder fingerprint)
        is published at /.well-known/assetlinks.json on that host. The in-app sign-in is offered only
        once its Cloud readiness probe sees this phone's App Link verified for the sign-in return
        host; until then the Cloud sign-in hand-off stays the product path. The custom scheme above
        remains the active Cloud delegation return path. -->
  </activity>
 </application>
</manifest>
