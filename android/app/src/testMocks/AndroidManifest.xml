<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
 <!-- Test-mocks overlay: attached to debug variants only with -PELIZA_DEV_ALLOW_TEST_MOCKS=1. -->
 <uses-permission android:name="android.permission.RECORD_AUDIO" />
 <uses-permission android:name="ai.elizaresearch.alphaphone.peerfixture.permission.CONTROL" />
 <queries><package android:name="ai.elizaresearch.alphaphone.peerfixture" /></queries>
 <application android:usesCleartextTraffic="true" android:networkSecurityConfig="@xml/development_network_security_config" tools:replace="android:usesCleartextTraffic,android:networkSecurityConfig">
  <!-- Staging Eliza Cloud sign-in return, test-mocks builds only. Staging assetlinks lists the debug and
       release certificates. For another debug keystore, approve the host for this package with adb's
       pm set-app-links-user-selection command (docs/cloud-subscription-qa.md has the exact line). -->
  <activity android:name=".MainActivity" tools:node="merge">
   <intent-filter android:autoVerify="true"><action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/><data android:scheme="https" android:host="${stagingCloudWebHost}" android:path="/alphaphone/auth/callback"/></intent-filter>
  </activity>
  <service android:name=".SyntheticAutofillService" android:exported="true" android:permission="android.permission.BIND_AUTOFILL_SERVICE">
   <intent-filter><action android:name="android.service.autofill.AutofillService" /></intent-filter>
   <meta-data android:name="android.autofill" android:resource="@xml/synthetic_autofill_service" />
  </service>
 </application>
</manifest>
