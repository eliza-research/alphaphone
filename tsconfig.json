{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@elizaos/contracts/native-notes-query": [
        "./.eliza/client-features/packages/contracts/src/native-notes-query.ts"
      ],
      "@elizaos/voice/turn": [
        "./.eliza/client-features/packages/voice/src/turn.ts"
      ],
      "@elizaos/core/speech": [
        "./.eliza/client-features/packages/core/src/speech.ts"
      ],
      "@elizaos/ui/voice/batch-conversation": [
        "./.eliza/client-features/packages/ui/src/voice/batch-conversation.ts"
      ],
      "@elizaos/ui/voice/voice-chat-playback": [
        "./.eliza/client-features/packages/ui/src/voice/voice-chat-playback.ts"
      ],
      "@elizaos/ui/voice/voice-session-client": [
        "./.eliza/client-features/packages/ui/src/voice/voice-session-client-core.ts"
      ],
      "@elizaos/host/voice/ui-context": [
        "./.eliza/client-features/packages/host/src/voice/ui-context.ts"
      ],
      "@elizaos/core/logging": [
        "./.eliza/client-features/packages/core/src/logging.ts"
      ],
      "@elizaos/core/view-interaction": [
        "./.eliza/client-features/packages/core/src/view-interaction.ts"
      ],
      "@elizaos/core/protocol": [
        "./.eliza/client-features/alpha-voice-core-protocol.ts"
      ],
      "@elizaos/core": [
        "./.eliza/client-features/alpha-voice-core-types.ts"
      ],
      "@elizaos/contracts": [
        "./.eliza/client-features/client-contracts.ts"
      ],
      "@elizaos/ui": [
        "./.eliza/client-features/alpha-client-fetch-types.ts"
      ],
      "@elizaos/plugin-assistant/device-calendar-contract": [
        "./.eliza/client-features/plugins/plugin-assistant/src/services/device-actions/calendar-contract.ts"
      ],
      "@elizaos/plugin-assistant/device-foreground-review": [
        "./.eliza/client-features/plugins/plugin-assistant/src/services/device-actions/foreground-review-contract.ts"
      ]
    }
  },
  "include": [
    "apps/app/src",
    "vite.config.ts",
    "capacitor.config.ts"
  ]
}
