{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@elizaos/contracts/native-notes-query": [
        "./.eliza/client-features/packages/contracts/src/native-notes-query.ts"
      ],
      "@elizaos/voice/turn": [
        "./.eliza/client-features/packages/voice/src/turn.ts"
      ],
      "@elizaos/core/speech": [
        "./.eliza/client-features/packages/core/src/speech.ts"
      ],
      "@elizaos/ui/voice/batch-conversation": [
        "./.eliza/client-features/packages/ui/src/voice/batch-conversation.ts"
      ],
      "@elizaos/ui/voice/voice-session-client": [
        "./.eliza/client-features/packages/ui/src/voice/voice-session-client.ts"
      ],
      "@elizaos/host/protocol": [
        "./.eliza/client-features/packages/host/src/voice.ts"
      ],
      "@elizaos/core/protocol": [
        "./.eliza/client-features/alpha-voice-core-protocol.ts"
      ],
      "@elizaos/core": [
        "./.eliza/client-features/alpha-voice-core-types.ts"
      ]
    }
  },
  "include": [
    "apps/app/src",
    "vite.config.ts",
    "capacitor.config.ts"
  ]
}
