{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alphaphone/docs/runbooks/drafts/666-latency-report.schema.json",
  "title": "Deployed plan-admission latency report (committed form)",
  "description": "The results.json written by the pinned upstream packages/cloud/scripts/plan-admission-deployed-latency.ts (DeployedLatencyResult, schema 1), wrapped with the provenance Alpha needs. It holds timings, statuses and outcome counts only: no key, token, account, organization, query text or response body. scripts/owner/latency-report.mjs check enforces this schema and a credential scan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "environment", "upstreamRevision", "harness", "operatorConfirmation", "result"],
  "properties": {
    "schema": { "const": 1 },
    "kind": { "const": "plan-admission-deployed-latency" },
    "environment": { "enum": ["staging", "production"] },
    "upstreamRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "harness": { "const": "packages/cloud/scripts/plan-admission-deployed-latency.ts" },
    "operatorConfirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmedBy", "confirmedAt", "billingOutageProducedBy"],
      "properties": {
        "confirmedBy": { "type": "string", "description": "Role of the Cloud operator who confirmed the run (a role, not an email or account id)", "maxLength": 80 },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "billingOutageProducedBy": { "type": ["string", "null"], "maxLength": 200, "description": "How the operator made the billing store unavailable, or null when that condition was not run" }
      }
    },
    "result": { "$ref": "#/$defs/result" }
  },
  "$defs": {
    "outcome": { "enum": ["admitted", "rate-limited", "allowance-exhausted", "subscription-required", "billing-refused", "cache-warming", "unauthorized", "unavailable", "unexpected"] },
    "summary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["n", "p50", "p95", "mean"],
      "properties": { "n": { "type": "integer", "minimum": 1 }, "p50": { "type": "number" }, "p95": { "type": "number" }, "mean": { "type": "number" } }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "service", "expected", "outcomes", "statuses", "mismatches", "client", "gatewayAuth", "gatewayPreforward", "addedOverBaseline"],
      "properties": {
        "condition": { "enum": ["baseline", "normal", "cache-miss", "exhausted", "expired", "billing-outage"] },
        "service": { "enum": ["network", "inference", "maps"] },
        "expected": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/outcome" } },
        "outcomes": { "type": "object", "propertyNames": { "$ref": "#/$defs/outcome" }, "additionalProperties": { "type": "integer", "minimum": 0 } },
        "statuses": { "type": "object", "propertyNames": { "pattern": "^[0-9]{1,3}$" }, "additionalProperties": { "type": "integer", "minimum": 0 } },
        "mismatches": { "type": "integer", "minimum": 0 },
        "client": { "$ref": "#/$defs/summary" },
        "gatewayAuth": { "$ref": "#/$defs/summary" },
        "gatewayPreforward": { "$ref": "#/$defs/summary" },
        "addedOverBaseline": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["p50", "p95"],
          "properties": { "p50": { "type": "number" }, "p95": { "type": "number" } }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "generatedAt", "apiBase", "iterations", "warmup", "baseline", "series", "expectationsMet"],
      "properties": {
        "schema": { "const": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "apiBase": { "type": "string", "pattern": "^https://[a-z0-9.-]+$" },
        "iterations": { "type": "integer", "minimum": 5, "maximum": 2000 },
        "warmup": { "type": "integer", "minimum": 0, "maximum": 50 },
        "baseline": { "$ref": "#/$defs/series" },
        "series": { "type": "array", "items": { "$ref": "#/$defs/series" } },
        "expectationsMet": { "type": "boolean" }
      }
    }
  }
}
